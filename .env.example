# ==========================================
# CẤU HÌNH HỆ THỐNG AFFILIATE AUTOMATION
# ==========================================

# 1. WORDPRESS CONFIGURATION (REST API)
WP_URL=https://your-affiliate-website.com
WP_USERNAME=your_wp_admin_username
# Tạo Application Password tại: WP Admin -> Users -> Profile -> Application Passwords
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx
WP_POST_STATUS=draft # 'draft' để kiểm tra trước hoặc 'publish' để đăng ngay lập tức
WP_DEFAULT_AUTHOR_ID=1

# 2. AMAZON ASSOCIATES CONFIGURATION
AMAZON_TAG=yourtag-20
# Tùy chọn nếu có Amazon Product Advertising API (PA-API v5):
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_HOST=webservices.amazon.com
AMAZON_REGION=us-east-1

# 3. EBAY PARTNER NETWORK (EPN) - TÙY CHỌN
EBAY_CAMPAIGN_ID=
EBAY_CUSTOM_ID=

# 4. LLM API KEYS (Hỗ trợ Anthropic Claude, OpenAI hoặc Google Gemini)
# Chọn nhà cung cấp LLM chính: 'anthropic', 'openai', hoặc 'gemini'
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# 5. DATAFORSEO API (Tùy chọn - Dùng cho OpenSEO Keyword Research & SERP)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# 6. THIẾT LẬP THƯƠNG HIỆU & AFFILIATE
SITE_NAME="TopPicks Advisor"
AFFILIATE_DISCLOSURE="As an Amazon Associate and affiliate partner, we earn from qualifying purchases at no additional cost to you."
